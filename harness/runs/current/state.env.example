# 이 파일을 harness/runs/current/state.env 로 복사해서 현재 run 상태 파일로 사용한다.
#
# hook은 이 상태 파일을 읽어서 현재 작업 유형, 범위, 계획 문서,
# 스펙 영향도, 검증 로그, 커밋 메시지 등을 판단한다.

# 작업 유형.
# 예: backend-rest-api, public-api-integration, bugfix, frontend-change, fullstack-feature,
# documentation-harness, git-only
WORKFLOW=

# 이번 run에서 먼저 진행할 작업 범위.
# 예: backend, frontend, api-integration, documentation-harness, git
SCOPE=

# 감지된 카테고리 목록(커밋을 나누는 용도로만 사용, 계획 단계에서 순서를 나누지 않는다).
# 여러 개면 쉼표로 구분한다. 예: backend,frontend
CATEGORIES=

# 이 작업을 현재 브랜치에서 이어갈지 새 브랜치로 뗄지.
# 값: continue-current(열린 PR의 파생 작업), new-branch(무관한 새 작업 또는 이미 머지된 코드에 대한 이슈)
BRANCH_DECISION=

# 브랜치 결정 이유(한두 문장).
BRANCH_DECISION_REASON=

# 계획 문서 경로.
PLAN_FILE=

# 우리 서버가 제공하는 API 스펙 영향 여부.
# 값: changed, unchanged
INTERNAL_API_SPEC_IMPACT=

# 외부 공공 API 연동 스펙 영향 여부.
# 값: changed, unchanged, not-applicable
EXTERNAL_API_SPEC_IMPACT=

# 스펙 확인 결과를 반영해 계획을 확정했는지 여부.
PLAN_FINALIZED=false

# 계획에서 비교한 접근 방법과 trade-off가 기록되었는지 여부.
TRADE_OFF_REVIEWED=false

# 화면(UI) 변경이 있는 작업인지 여부.
# 값: yes, no
UI_IMPACT=no

# UI_IMPACT=yes일 때, 화면 전체가 바뀌는지 일부만 바뀌는지.
# 값: full-screen, partial
UI_CHANGE_KIND=

# UI_CHANGE_KIND=full-screen일 때 모바일/데스크톱 예상 화면을 보여주는 HTML 목업 파일 경로.
UI_MOCKUP_FILE=

# UI_CHANGE_KIND=partial일 때 계획 문서에 변경 내용 스펙을 기록했는지 여부.
UI_CHANGE_SPEC_RECORDED=false

# 사용자가 확정된 계획을 승인했는지 여부.
PLAN_APPROVED_BY_USER=false

# 작업 전체에서 한 번만 수행하는 코드 리뷰 상태와 결과 파일.
# 결과에는 코드와 관련 Markdown 기준 문서의 정합성 확인이 포함되어야 한다.
# 값: completed
CODE_REVIEW_STATUS=
CODE_REVIEW_FILE=
CODE_REVIEW_COUNT=0

# 검증 로그 파일 경로.
VERIFICATION_LOG=

# 화면/이미지 검증이 필요한 경우 스크린샷 디렉터리.
SCREENSHOT_DIR=

# 커밋 메시지 초안 파일 경로.
COMMIT_MESSAGE_FILE=

# Map/HashMap 사용에 대해 사용자 승인을 받았는지 여부.
MAP_USAGE_APPROVED=false
